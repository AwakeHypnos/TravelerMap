  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.rec-type {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background-color: rgba(255, 255, 255, 0.2);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

.rec-match {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.rec-title {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.rec-description {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 12rpx;
}

.rec-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.rec-meta .meta-item {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  background-color: rgba(255, 255, 255, 0.15);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.rec-meta .meta-item.hot {
  background-color: rgba(255, 107, 107, 0.3);
  color: #ffffff;
}

.rec-tips {
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.tips-title {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  margin-bottom: 6rpx;
}

.tip-item {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  display: block;
  margin-bottom: 4rpx;
}

.route-locations .location-dot {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.dot-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 12rpx;
}

.dot-number {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background-color: #3498db;
  color: #ffffff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dot-line {
  width: 2rpx;
  height: 30rpx;
  background-color: #3498db;
  opacity: 0.4;
}

.dot-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-top: 2rpx;
}

.dot-name {
  font-size: 24rpx;
  color: #2c3e50;
  margin-bottom: 2rpx;
}

.dot-distance {
  font-size: 20rpx;
  color: #95a5a6;
}
