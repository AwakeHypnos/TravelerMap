.container {
  padding: 0;
  background: linear-gradient(180deg, #3498db 0%, #2980b9 100%);
  min-height: 100vh;
}

.search-section {
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(180deg, #3498db 0%, #2980b9 100%);
}

.location-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.location-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.location-text {
  color: #ffffff;
  font-size: 26rpx;
}

.search-box {
  background-color: #ffffff;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.search-input-wrapper {
  display: flex;
  align-items: center;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-placeholder {
  color: #999999;
}

.quick-actions-section {
  background-color: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  margin-top: 20rpx;
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
}

.clear-btn {
  font-size: 24rpx;
  color: #95a5a6;
}

.quick-actions-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.action-item {
  width: 48%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
  background-color: #f8f9fa;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.action-item:active {
  opacity: 0.7;
  transform: scale(0.98);
}

.action-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.action-name {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}

.recent-section {
  background-color: #ffffff;
  padding: 30rpx;
  margin-top: 20rpx;
}

.recent-category {
  margin-bottom: 20rpx;
}

.category-title {
  font-size: 26rpx;
  color: #7f8c8d;
}

.recent-list {
  margin-bottom: 30rpx;
}

.recent-list:last-child {
  margin-bottom: 0;
}

.recent-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-item:active {
  opacity: 0.7;
}

.recent-item-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.recent-name {
  font-size: 30rpx;
  color: #2c3e50;
  margin-bottom: 6rpx;
}

.recent-address {
  font-size: 24rpx;
  color: #95a5a6;
}

.recent-distance {
  font-size: 24rpx;
  color: #3498db;
  margin-left: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  background-color: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  margin-top: 20rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #2c3e50;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: #95a5a6;
}
