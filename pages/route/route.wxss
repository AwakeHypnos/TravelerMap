.container {
  padding: 20rpx;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.mode-selector {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.mode-tabs {
  display: flex;
  gap: 20rpx;
}

.mode-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.mode-tab.active {
  background-color: #e8f4fc;
  border-color: #3498db;
}

.tab-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.tab-name {
  font-size: 26rpx;
  color: #7f8c8d;
}

.mode-tab.active .tab-name {
  color: #3498db;
  font-weight: 500;
}

.time-plan-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.time-plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.time-plan-header .section-title {
  margin-bottom: 0;
}

.toggle-icon {
  font-size: 24rpx;
  color: #95a5a6;
}

.time-plan-content {
  padding: 0 24rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.time-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.time-item:last-child {
  margin-bottom: 0;
}

.time-label {
  font-size: 26rpx;
  color: #7f8c8d;
  width: 200rpx;
}

.time-picker {
  flex: 1;
  padding: 16rpx 20rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
}

.time-value {
  font-size: 28rpx;
  color: #2c3e50;
}

.time-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #2c3e50;
}

.locations-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.action-text {
  font-size: 26rpx;
  color: #e74c3c;
}

.locations-list {
  display: flex;
  flex-direction: column;
}

.location-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.location-item:last-child {
  border-bottom: none;
}

.location-select {
  margin-right: 20rpx;
  padding-top: 4rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
}

.checkbox.checked {
  background-color: #3498db;
  border-color: #3498db;
}

.checkbox text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
}

.location-info {
  flex: 1;
}

.location-name {
  font-size: 30rpx;
  color: #2c3e50;
  font-weight: 500;
  display: block;
  margin-bottom: 6rpx;
}

.location-address {
  font-size: 24rpx;
  color: #95a5a6;
  display: block;
  margin-bottom: 10rpx;
}

.location-meta {
  display: flex;
  gap: 20rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #7f8c8d;
  background-color: #f8f9fa;
  padding: 6rpx 12rpx;
  border-radius: 4rpx;
}

.location-actions {
  margin-left: 20rpx;
}

.action-remove {
  font-size: 32rpx;
  color: #95a5a6;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-locations {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #7f8c8d;
  margin-bottom: 10rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  color: #95a5a6;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  padding: 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.btn-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background-color: #ecf0f1;
  border-radius: 50rpx;
}

.btn-secondary:active,
.btn-primary:active {
  opacity: 0.8;
}

.btn-primary {
  flex: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #3498db, #2980b9);
  border-radius: 50rpx;
}

.btn-primary.disabled {
  opacity: 0.5;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
}

.btn-secondary .btn-text {
  color: #2c3e50;
}

.btn-primary .btn-text {
  color: #ffffff;
}

.add-panel-overlay,
.result-panel-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.overlay-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.add-panel,
.result-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  max-height: 80vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
}

.close-btn {
  font-size: 36rpx;
  color: #95a5a6;
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-panel .mode-selector {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 0;
}

.mode-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.mode-option.active {
  background-color: #e8f4fc;
  border-color: #3498db;
}

.mode-option-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.mode-option-text {
  font-size: 24rpx;
  color: #7f8c8d;
}

.mode-option.active .mode-option-text {
  color: #3498db;
}

.search-section,
.map-section {
  padding: 20rpx 30rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #f8f9fa;
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2c3e50;
}

.search-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #3498db;
  border-radius: 50%;
  margin-left: 16rpx;
}

.search-btn-icon {
  font-size: 28rpx;
  color: #ffffff;
}

.search-results {
  margin-top: 20rpx;
  max-height: 40vh;
  overflow-y: scroll;
}

.search-result-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-result-item:last-child {
  border-bottom: none;
}

.result-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.result-name {
  font-size: 28rpx;
  color: #2c3e50;
  margin-bottom: 4rpx;
}

.result-address {
  font-size: 22rpx;
  color: #95a5a6;
}

.result-distance {
  font-size: 22rpx;
  color: #3498db;
  margin-left: 16rpx;
}

.map-tip {
  text-align: center;
  font-size: 26rpx;
  color: #7f8c8d;
  margin-bottom: 30rpx;
}

.route-summary {
  padding: 30rpx;
  background: linear-gradient(135deg, #f8f9fa, #ffffff);
}

.summary-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #3498db;
}

.stat-label {
  font-size: 22rpx;
  color: #7f8c8d;
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #e0e0e0;
}

.route-path {
  padding: 30rpx;
  max-height: 50vh;
  overflow-y: scroll;
}

.path-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.path-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
}

.path-mode {
  font-size: 22rpx;
  color: #3498db;
  background-color: #e8f4fc;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
}

.path-list {
  display: flex;
  flex-direction: column;
}

.path-item {
  display: flex;
  margin-bottom: 24rpx;
}

.path-item:last-child {
  margin-bottom: 0;
}

.path-number-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
}

.path-number {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #f8f9fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #7f8c8d;
  border: 2rpx solid #e0e0e0;
  flex-shrink: 0;
}

.path-number.start {
  background-color: #27ae60;
  border-color: #27ae60;
  color: #ffffff;
}

.path-number.end {
  background-color: #e74c3c;
  border-color: #e74c3c;
  color: #ffffff;
}

.path-line {
  width: 2rpx;
  height: 60rpx;
  background-color: #e0e0e0;
  margin: 8rpx 0;
}

.path-info {
  flex: 1;
}

.path-name {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
  display: block;
  margin-bottom: 6rpx;
}

.path-address {
  font-size: 22rpx;
  color: #95a5a6;
  display: block;
  margin-bottom: 10rpx;
}

.path-meta {
  display: flex;
  gap: 16rpx;
}

.result-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 50rpx;
}

.action-btn.primary {
  background: linear-gradient(135deg, #3498db, #2980b9);
}

.action-btn.secondary {
  background-color: #ecf0f1;
}

.action-btn.primary .action-text {
  color: #ffffff;
}

.action-btn.secondary .action-text {
  color: #2c3e50;
}
