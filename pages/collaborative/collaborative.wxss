.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.welcome-section {
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.welcome-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.welcome-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 16rpx;
}

.welcome-subtitle {
  font-size: 28rpx;
  color: #3498db;
  margin-bottom: 20rpx;
}

.welcome-desc {
  font-size: 24rpx;
  color: #95a5a6;
  text-align: center;
  line-height: 1.6;
}

.welcome-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.action-card:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.action-card.create {
  background: linear-gradient(135deg, #3498db, #2980b9);
}

.action-card.join {
  background: linear-gradient(135deg, #27ae60, #229954);
}

.card-icon {
  font-size: 56rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.card-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.room-section {
  padding-bottom: 40rpx;
}

.room-header {
  background-color: #ffffff;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.room-info {
  display: flex;
  flex-direction: column;
}

.room-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 6rpx;
}

.room-id {
  font-size: 24rpx;
  color: #95a5a6;
}

.room-actions {
  display: flex;
  gap: 20rpx;
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  background-color: #f8f9fa;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon:active {
  opacity: 0.7;
}

.icon-text {
  font-size: 32rpx;
}

.members-section,
.markers-section,
.decision-section {
  background-color: #ffffff;
  margin-top: 20rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
}

.section-status {
  font-size: 22rpx;
  color: #3498db;
  background-color: #e8f4fc;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
}

.section-actions {
  display: flex;
  gap: 20rpx;
}

.action-text {
  font-size: 26rpx;
  color: #3498db;
}

.members-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.member-item.empty-slot {
  opacity: 0.5;
  border-style: dashed;
  border-width: 2rpx;
  border-color: #e0e0e0;
  background-color: transparent;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3498db, #2980b9);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.member-avatar.empty {
  background-color: #ecf0f1;
  border: 2rpx dashed #bdc3c7;
}

.avatar-icon {
  font-size: 32rpx;
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.member-name {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.member-role {
  font-size: 22rpx;
  color: #95a5a6;
}

.member-status {
  display: flex;
  align-items: center;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #27ae60;
}

.markers-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.marker-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.marker-item:active {
  opacity: 0.7;
}

.marker-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #e8f4fc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.marker-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.marker-name {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.marker-desc,
.marker-address {
  font-size: 22rpx;
  color: #95a5a6;
  margin-bottom: 4rpx;
}

.marker-meta {
  margin-top: 6rpx;
}

.meta-text {
  font-size: 20rpx;
  color: #bdc3c7;
}

.marker-actions {
  margin-left: 16rpx;
}

.edit-icon {
  font-size: 36rpx;
  color: #95a5a6;
  padding: 10rpx;
}

.empty-markers {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #7f8c8d;
  margin-bottom: 8rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  color: #95a5a6;
}

.decision-actions {
  display: flex;
  gap: 20rpx;
}

.decision-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  border-radius: 16rpx;
}

.decision-btn:active {
  opacity: 0.7;
}

.decision-btn.vote {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
}

.decision-btn.random {
  background: linear-gradient(135deg, #f39c12, #e67e22);
}

.btn-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.btn-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.btn-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-content.large {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-content.result {
  max-height: 70vh;
}

.modal-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
}

.voting-status {
  font-size: 24rpx;
  color: #95a5a6;
  margin-top: 8rpx;
}

.modal-body {
  padding: 30rpx;
}

.modal-body.scrollable {
  max-height: 50vh;
  overflow-y: scroll;
}

.input-group {
  margin-bottom: 30rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.input-label {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-bottom: 12rpx;
  display: block;
}

.input-field {
  width: 100%;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #2c3e50;
  box-sizing: border-box;
}

.textarea-field {
  width: 100%;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #2c3e50;
  min-height: 150rpx;
  box-sizing: border-box;
}

.location-select {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.location-select:active {
  opacity: 0.7;
}

.location-text {
  font-size: 28rpx;
  color: #2c3e50;
}

.location-arrow {
  font-size: 28rpx;
  color: #c0c0c0;
}

.room-tip {
  padding: 20rpx;
  background-color: #fff3cd;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #856404;
  line-height: 1.6;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  padding: 22rpx;
  text-align: center;
  border-radius: 50rpx;
}

.modal-btn.secondary {
  background-color: #ecf0f1;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #3498db, #2980b9);
}

.modal-btn.secondary .btn-text {
  font-size: 28rpx;
  color: #2c3e50;
}

.modal-btn.primary .btn-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}

.vote-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.vote-item:last-child {
  margin-bottom: 0;
}

.vote-item.selected {
  background-color: #e8f4fc;
  border-color: #3498db;
}

.vote-item:active {
  opacity: 0.7;
}

.vote-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.vote-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.vote-name {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.vote-desc {
  font-size: 22rpx;
  color: #95a5a6;
}

.vote-count {
  margin-left: 16rpx;
}

.count-text {
  font-size: 24rpx;
  color: #3498db;
  font-weight: 600;
}

.vote-indicator {
  margin-left: 16rpx;
}

.indicator-icon {
  font-size: 28rpx;
  color: #c0c0c0;
}

.result-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
}

.winner-section {
  padding: 30rpx;
  display: flex;
  justify-content: center;
}

.winner-card {
  background: linear-gradient(135deg, #3498db, #2980b9);
  border-radius: 20rpx;
  padding: 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.winner-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 10rpx;
}

.winner-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.winner-votes {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.results-list {
  padding: 0 30rpx 20rpx;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #f8f9fa;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.rank-number {
  font-size: 24rpx;
  color: #7f8c8d;
  font-weight: 500;
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
}

.result-name {
  font-size: 26rpx;
  color: #2c3e50;
  margin-bottom: 4rpx;
}

.result-votes {
  font-size: 22rpx;
  color: #95a5a6;
}

.result-bar {
  width: 120rpx;
  height: 12rpx;
  background-color: #f8f9fa;
  border-radius: 6rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #3498db, #2980b9);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.random-section {
  padding: 30rpx;
  display: flex;
  justify-content: center;
}

.random-card {
  background: linear-gradient(135deg, #f39c12, #e67e22);
  border-radius: 20rpx;
  padding: 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.random-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 10rpx;
}

.random-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.random-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}
