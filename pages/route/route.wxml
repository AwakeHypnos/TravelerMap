<view class="container">
  <view class="mode-selector">
    <view class="section-title">选择路线模式</view>
    <view class="mode-tabs">
      <view 
        class="mode-tab {{routeMode === 'shortest' ? 'active' : ''}}" 
        data-mode="shortest" 
        bindtap="onRouteModeChange"
      >
        <text class="tab-icon">🚀</text>
        <text class="tab-name">最短路线</text>
      </view>
      <view 
        class="mode-tab {{routeMode === 'optimal' ? 'active' : ''}}" 
        data-mode="optimal" 
        bindtap="onRouteModeChange"
      >
        <text class="tab-icon">🔄</text>
        <text class="tab-name">环游路线</text>
      </view>
    </view>
  </view>

  <view class="time-plan-section" wx:if="{{!showResultPanel}}">
    <view class="time-plan-header" bindtap="onToggleTimePlan">
      <text class="section-title">时间计划</text>
      <text class="toggle-icon">{{showTimePlan ? '▲' : '▼'}}</text>
    </view>
    
    <view class="time-plan-content" wx:if="{{showTimePlan}}">
      <view class="time-item">
        <text class="time-label">出发时间</text>
        <picker mode="time" value="{{timePlan.startTime}}" bindchange="onTimeStartChange">
          <view class="time-picker">
            <text class="time-value">{{timePlan.startTime || '选择时间'}}</text>
          </view>
        </picker>
      </view>
      
      <view class="time-item">
        <text class="time-label">每个地点停留(分钟)</text>
        <input 
          class="time-input" 
          type="number" 
          value="{{timePlan.timePerLocation}}" 
          bindchange="onTimePerLocationChange"
        />
      </view>
      
      <view class="time-item">
        <text class="time-label">总时长限制(分钟)</text>
        <input 
          class="time-input" 
          type="number" 
          value="{{timePlan.maxTotalTime}}" 
          bindchange="onMaxTimeChange"
        />
      </view>
    </view>
  </view>

  <view class="locations-section">
    <view class="section-header">
      <text class="section-title">选择地点 ({{activeLocationCount}})</text>
      <view class="header-actions">
        <text class="action-text" bindtap="onClearAll" wx:if="{{selectedLocations.length > 0}}">清除全部
      </view>
    </view>
    
    <view class="locations-list" wx:if="{{selectedLocations.length > 0 && !showResultPanel}}">
      <view 
        class="location-item" 
        wx:for="{{selectedLocations}}" 
        wx:key="id"
        data-id="{{item.id}}"
      >
        <view class="location-select" bindtap="onToggleLocationSelect">
          <view class="checkbox {{item.selected ? 'checked' : ''}}">
            <text wx:if="{{item.selected}}">✓</text>
          </view>
        </view>
        
        <view class="location-info">
          <text class="location-name">{{item.name || '未命名地点'}}</text>
          <text class="location-address">{{item.address}}</text>
          <view class="location-meta">
            <text class="meta-item" bindtap="onEditEstimatedTime" data-id="{{item.id}}">
              ⏱️ 停留 {{item.estimatedTime}}分钟
            </text>
            <text class="meta-item" wx:if="{{item.distanceText}}">
              📍 {{item.distanceText}}
            </text>
          </view>
        </view>
        
        <view class="location-actions">
          <text class="action-remove" bindtap="onRemoveLocation" data-id="{{item.id}}">✕</text>
        </view>
      </view>
    </view>
    
    <view class="empty-locations" wx:if="{{selectedLocations.length === 0 && !showResultPanel}}">
      <text class="empty-icon">📍</text>
      <text class="empty-text">还没有添加地点</text>
      <text class="empty-subtitle">点击下方按钮添加目的地</text>
    </view>
  </view>

  <view class="bottom-actions" wx:if="{{!showResultPanel}}">
    <view class="btn-secondary" bindtap="onAddLocation">
      <text class="btn-icon">➕</text>
      <text class="btn-text">添加地点</text>
    </view>
    <view 
      class="btn-primary {{canPlanRoute ? '' : 'disabled'}}" 
      bindtap="onPlanRoute"
    >
      <text class="btn-text">开始规划</text>
    </view>
  </view>

  <view class="add-panel-overlay" wx:if="{{showAddPanel}}">
    <view class="overlay-bg" bindtap="onCloseAddPanel"></view>
    <view class="add-panel">
      <view class="panel-header">
        <text class="panel-title">添加地点</text>
        <text class="close-btn" bindtap="onCloseAddPanel">✕</text>
      </view>
      
      <view class="mode-selector">
        <view 
          class="mode-option {{locationMode === 'search' ? 'active' : ''}}" 
          data-mode="search" 
          bindtap="onLocationModeChange"
        >
          <text class="mode-option-icon">🔍</text>
          <text class="mode-option-text">搜索地点</text>
        </view>
        <view 
          class="mode-option {{locationMode === 'map' ? 'active' : ''}}" 
          data-mode="map" 
          bindtap="onLocationModeChange"
        >
          <text class="mode-option-icon">🗺️</text>
          <text class="mode-option-text">地图选择</text>
        </view>
      </view>
      
      <view class="search-section" wx:if="{{locationMode === 'search'}}">
        <view class="search-box">
          <input 
            class="search-input" 
            placeholder="搜索地点名称..." 
            value="{{searchKeyword}}"
            bindinput="onSearchInput"
            bindconfirm="onSearchConfirm"
            focus
          />
          <view class="search-btn" bindtap="onSearchConfirm">
            <text class="search-btn-icon">🔍</text>
          </view>
        </view>
        
        <view class="search-results" wx:if="{{showSearch && searchResults.length > 0}}">
          <view 
            class="search-result-item" 
            wx:for="{{searchResults}}" 
            wx:key="id"
            data-location="{{item}}"
            bindtap="onSelectSearchResult"
          >
            <text class="result-icon">📍</text>
            <view class="result-info">
              <text class="result-name">{{item.name}}</text>
              <text class="result-address">{{item.address}}</text>
            </view>
            <text class="result-distance" wx:if="{{item.distance}}">{{item.distanceText}}</text>
          </view>
        </view>
      </view>
      
      <view class="map-section" wx:if="{{locationMode === 'map'}}">
        <view class="map-tip">点击下方按钮在地图上选择地点</view>
        <view class="btn-primary" bindtap="onChooseLocation">
          <text class="btn-icon">📍</text>
          <text class="btn-text">打开地图选择</text>
        </view>
      </view>
    </view>
  </view>

  <view class="result-panel-overlay" wx:if="{{showResultPanel}}">
    <view class="overlay-bg"></view>
    <view class="result-panel">
      <view class="panel-header">
        <text class="panel-title">规划结果</text>
        <text class="close-btn" bindtap="onCloseResultPanel">✕</text>
      </view>
      
      <view class="route-summary">
        <view class="summary-stats">
          <view class="stat-item">
            <text class="stat-value">{{plannedRoute.locationCount}}</text>
            <text class="stat-label">地点</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-value">{{plannedRoute.totalDistanceText}}</text>
            <text class="stat-label">总距离</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-value">{{plannedRoute.totalTimeText}}</text>
            <text class="stat-label">预计时间</text>
          </view>
        </view>
      </view>
      
      <view class="route-path">
        <view class="path-header">
          <text class="path-title">推荐路线顺序</text>
          <text class="path-mode">{{routeMode === 'shortest' ? '最短路线' : '环游路线'}}</text>
        </view>
        
        <view class="path-list">
          <view class="path-item" wx:for="{{plannedRoute.path}}" wx:key="id">
            <view class="path-number-wrapper">
              <view class="path-number {{index === 0 ? 'start' : index === plannedRoute.path.length - 1 ? 'end' : ''}}">
                {{index + 1}}
              </view>
              <view class="path-line" wx:if="{{index < plannedRoute.path.length - 1}}"></view>
            </view>
            <view class="path-info">
              <text class="path-name">{{item.name || '未命名地点'}}</text>
              <text class="path-address" wx:if="{{item.address}}">{{item.address}}</text>
              <view class="path-meta" wx:if="{{item.estimatedTime || item.distanceText}}">
                <text class="meta-item" wx:if="{{item.estimatedTime}}">⏱️ {{item.estimatedTime}}分钟</text>
                <text class="meta-item" wx:if="{{item.distanceText}}">📍 {{item.distanceText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <view class="result-actions">
        <view class="action-btn secondary" bindtap="onShareRoute">
          <text class="action-icon">📤</text>
          <text class="action-text">分享路线</text>
        </view>
        <view class="action-btn primary" bindtap="onViewOnMap">
          <text class="action-icon">🗺️</text>
          <text class="action-text">查看地图</text>
        </view>
      </view>
    </view>
  </view>
</view>
